# LockOn ServiceOS
# Development korzysta z lokalnego backendu pod http://127.0.0.1:8787.
# Pakietowana aplikacja ma centralny endpoint Neon w konfiguracji; LOCKON_API_URL pozwala go nadpisać lokalnie.
LOCKON_API_URL=http://127.0.0.1:8787
LOCKON_API_PORT=8787
LOCKON_API_HOST=127.0.0.1
LOCKON_OWNER_EMAIL=nowogar@gmail.com

# Desktop OAuth jest publicznym klientem i używa PKCE + state. Nie przechowuj client secretu w aplikacji.

# Tylko development backendu. Nie ustawiaj na produkcji.
LOCKON_ALLOW_DEV_LOGIN=1

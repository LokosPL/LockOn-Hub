# LockOn ServiceOS 0.4
# Development działa bez zmian pod http://127.0.0.1:8787.
# Dla wielu komputerów przez Internet wdroż katalog /server na serwer/VPS i ustaw URL API w środowisku aplikacji.
LOCKON_API_URL=http://127.0.0.1:8787
LOCKON_API_PORT=8787
LOCKON_API_HOST=127.0.0.1
LOCKON_OWNER_EMAIL=nowogar@gmail.com

# Nie commituj tego do GitHub.
LOCKON_GOOGLE_CLIENT_SECRET=

# Tylko development backendu. Nie ustawiaj na produkcji.
LOCKON_ALLOW_DEV_LOGIN=1

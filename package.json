{
  "name": "lockon-serviceos",
  "version": "1.0.5",
  "private": true,
  "description": "LockOn ServiceOS — centralny system serwisowy z klientami, naprawami, historią statusów, Google OAuth, bezpiecznymi powiadomieniami Gmail i pomocą per konto.",
  "author": "Bartłomiej Motłoch",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/LokosPL/LockOn-Hub.git"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 tcp:8787 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:web": "vite build",
    "build": "npm run build:web && npm run build:electron && npm run build:server",
    "dist": "npm run build && electron-builder --win",
    "release": "npm run build && electron-builder --win --publish always",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "dev:server": "cross-env LOCKON_ALLOW_DEV_LOGIN=1 node server/index.mjs",
    "server": "node server/index.mjs",
    "build:server": "esbuild server/index.mjs --bundle --platform=node --format=cjs --target=node22 --outfile=dist-server/index.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "google-auth-library": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "44.4.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3",
    "esbuild": "^0.25.12"
  },
  "build": {
    "appId": "pl.lockon.serviceos",
    "productName": "LockOn ServiceOS",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "dist-server/**/*",
      "server/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LockOn ServiceOS"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "LokosPL",
        "repo": "LockOn-Hub",
        "releaseType": "release"
      }
    ],
    "artifactName": "LockOn-ServiceOS-Setup.${ext}",
    "asarUnpack": [
      "dist-server/**/*"
    ]
  }
}

{
  "name": "lockon-serviceos",
  "version": "0.5.0",
  "private": true,
  "description": "LockOn ServiceOS — Google OAuth, autologowanie, intuicyjne zgłoszenia ról i punktów, panel akceptacji, rozliczenia 50/50, przeglądarka i aktualizacje GitHub",
  "author": "Bartłomiej Motłoch - Punkt Nowogard",
  "license": "UNLICENSED",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/LokosPL/LockOn-Hub.git"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 tcp:8787 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:web": "vite build",
    "build": "npm run build:web && npm run build:electron",
    "dist": "npm run build && electron-builder --win",
    "release": "npm run build && electron-builder --win --publish always",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "dev:server": "cross-env LOCKON_ALLOW_DEV_LOGIN=1 node server/index.mjs",
    "server": "node server/index.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "pl.lockon.serviceos",
    "productName": "LockOn ServiceOS",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LockOn ServiceOS"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "artifactName": "LockOn-ServiceOS-Setup.${ext}",
    "asarUnpack": [
      "server/**/*"
    ]
  }
}
